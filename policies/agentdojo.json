      ],
      "party": "value"
    },
    {
      "path": [
        "cloud_drive",
        "files",
        "*",
        "shared_with",
        "*"
      ],
      "party": "seg:-1"
    },
    {
      "path": [
        "calendar",
        "events",
        "*",
        "participants",
        "*"
      ],
      "party": "value"
    },
    {
      "path": [
        "slack",
        "users",
        "*"
      ],
      "party": "value"
    },
    {
      "path": [
        "slack",
        "channels",
        "*"
      ],
      "party": "value"
    },
    {
      "path": [
        "web",
        "web_content",
        "*"
      ],
      "party": "seg:-1"
    }
  ],
  "otherwise": {
    "add": "write",
    "change": "write",
    "remove": "destruct"
  }
}
